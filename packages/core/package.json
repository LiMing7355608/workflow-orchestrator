{
  "name": "@orchestrator/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/event-log.d.ts",
      "import": "./dist/event-log.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/event-log.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/event-log.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
