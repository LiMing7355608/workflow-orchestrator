# HTTP 服务端口
PORT=3000

# SQLite 数据库文件（运行时生成，不入库）
DATABASE_URL=./data/orchestrator.sqlite

# 事件日志。指向 ./data/events.jsonl 时按「分片根目录 = 其所在目录」理解：
# 每个 run 一个子目录 <root>/<runId>/events.jsonl，超限轮转为 events.1.jsonl …
# 该路径下已存在的旧单文件 events.jsonl 会被当成历史数据读入（只读不搬）。
EVENT_LOG_PATH=./data/events.jsonl
# 单个分片超过多少字节轮转，以及每个 run 保留几个归档分片
# JOURNAL_MAX_BYTES_PER_SHARD=8388608
# JOURNAL_MAX_SHARDS=5

# 结构化日志级别（pino）：trace / debug / info / warn / error / fatal
LOG_LEVEL=info

# 执行器：mock 回放不启进程（CI 与演示默认），real 拉起真实 Agent
AGENT_RUNNER=mock

# 工作区：git 为每个节点开独立 worktree（默认，只有它能采集出 diff 供审查节点阅读）；
# temp 用临时目录，作为无 git 环境的降级，此时审查节点拿不到上游改动
AGENT_WORKSPACE=git

# 默认目标目录（Agent 干活的地方，成果落在这里）。
# 新建运行时请求里的 workspaceRoot 优先；这里只是「没填时用什么」。
# 留空则回落到 server 的启动目录。目录必须已存在且是 git 仓库。
# AGENT_TARGET_DIR=D:/projects/calculator

# 节点 worktree 的存放根（运行时生成，不入库）。
# 刻意放在编排器自己的 data 下，而不是写进目标仓库——那是用户自己的工程。
# AGENT_WORKTREE_DIR=./data/worktrees

# 节点 diff 落盘目录（运行时生成，不入库）
AGENT_ARTIFACT_DIR=./data/artifacts

# 数据目录锁文件（运行时生成，不入库）。
# 一个数据目录只能有一个 server 写事件日志，抢不到锁的进程会打印持有者
# 信息后直接退出。默认在 data/ 下；确认没有实例在跑（例如崩溃残留）时
# 删掉这个文件即可。
LOCK_PATH=./data/orchestrator.lock

# Agent 子进程登记目录（运行时生成，不入库）。
# 每个子进程落一个 <pid>.json，重启时据此认出并回收上一轮留下的孤儿进程。
PROCESS_DIR=./data/processes

# 同一轮最多并行几个 Agent
AGENT_CONCURRENCY=2

# Planner 用哪个 Agent 拆图。留空则按「已装好 + 能结构化输出」自动挑
# PLANNER_AGENT_ID=claude
