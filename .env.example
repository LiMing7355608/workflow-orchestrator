# HTTP 服务端口
PORT=3000

# SQLite 数据库文件（运行时生成，不入库）
DATABASE_URL=./data/orchestrator.sqlite

# 事件日志（JSONL 追加写，不入库）
EVENT_LOG_PATH=./data/events.jsonl

# 执行器：mock 回放不启进程（CI 与演示默认），real 拉起真实 Agent
AGENT_RUNNER=mock

# 工作区：git 为每个节点开独立 worktree（默认，只有它能采集出 diff 供审查节点阅读）；
# temp 用临时目录，作为无 git 环境的降级，此时审查节点拿不到上游改动
AGENT_WORKSPACE=git

# 节点 diff 落盘目录（运行时生成，不入库）
AGENT_ARTIFACT_DIR=./data/artifacts

# 同一轮最多并行几个 Agent
AGENT_CONCURRENCY=2

# Planner 用哪个 Agent 拆图。留空则按「已装好 + 能结构化输出」自动挑
# PLANNER_AGENT_ID=claude
